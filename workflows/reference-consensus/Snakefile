"""Reference-guided cohort consensus: one consensus genome from many isolates' reads.

Every selected isolate's paired reads are called against one backbone
assembly; the isolates' alleles (and optionally the backbone's) then vote at
each position, and the winner by strict majority or plurality forms the
cohort consensus.

Steps, in the order they run (each is one rule; paths are inside the run
directory, and every step writes its log to logs/):

  1. resolve_backbone                    rules/resolve_backbone.smk
       Copy a local FASTA or download an NCBI accession, with a checksum.
       -> resolved/backbone.fasta
  2. validate_run_inputs                 rules/validate_run_inputs.smk
       Check the backbone FASTA and that every read file can be read.
       -> results/input-validation.json
  3. index_backbone                      rules/align_reads.smk
       -> resolved/backbone.fasta.{amb,ann,bwt,pac,sa,fai}

  Then for every read pair of every selected isolate ({pair} is the pair's
  1-based position in the isolate's snapshot entry), in
  results/isolates/{isolate}/pairs/{pair}/:

  4. validate_read_pair                  rules/validate_read_pair.smk
       Derive the read group from the Illumina read names; checksum the files.
  5. trim_read_pair                      rules/align_reads.smk
       fastp read QC and light adapter trimming.
  6. align_read_pair                     rules/align_reads.smk
       bwa mem with the pair's read group.

  And for every isolate, in results/isolates/{isolate}/:

  7. mark_duplicates, alignment_metrics  rules/align_reads.smk
       Merge the pairs, mark duplicates per library, report alignment metrics.
  8. call_all_sites, classify_callability, filter_normalize_variants
                                         rules/call_variants.smk
       Haploid calls at every covered position, the callable mask, and the
       normalized variants.
  9. build_isolate_consensus             rules/build_consensus.smk
       The isolate's reference-guided FASTA.
 10. summarize_isolate                   rules/build_consensus.smk
       Metrics, the isolate's provenance, and its promotion candidate.

  Then, once every isolate is processed:

 11. aggregate_support                   rules/aggregate_support.smk
       The backbone's and the callable isolates' votes at every position.
       -> results/cohort/initial/support-sites.tsv.gz, support-intervals.tsv.gz,
          support-summary.json
 12. generate_consensus                  rules/generate_consensus.smk
       The winning allele at every position by the configured voting method,
       and a record of every selected and unresolved site.
       -> results/cohort/initial/consensus.fasta, consensus-sites.tsv.gz,
          consensus-summary.json
 13. record_consensus_provenance         rules/record_provenance.smk
       Checksums, tool versions, and commands of the whole run.
       -> artifacts.yaml, provenance/run.json

Every file a run produces is listed in scripts/artifacts.py.

Iterations: steps 11 and 12 also run for a saved cohort decision,
decisions/iteration-<n>.yaml (n from 2 on), which names the voting isolates
and every cohort setting. Its outputs go to results/cohort/iteration-<n>/,
beside the untouched initial ones, and

 14. record_iteration_provenance         rules/record_provenance.smk
       The decision, the excluded isolates, checksums, and commands of the
       iteration.
       -> provenance/cohort/iteration-<n>.json

An iteration depends only on its voting isolates, so an excluded isolate,
also one that failed, does not stop it.

The isolates and their read files come from isolates.yaml, a snapshot of the
isolate catalog that GenoPilot saved next to config.yaml when the run was
created, so later catalog edits never change an existing run.

Running without GenoPilot: GenoPilot saves config.yaml and isolates.yaml
into a new run directory. The same run can then be started directly with

  snakemake --snakefile <package>/workflows/reference-consensus/Snakefile \
    --directory <run-dir> --configfile <run-dir>/config.yaml \
    --cores <n> --use-conda --keep-going

`--keep-going` lets the other isolates finish when one fails; the cohort
steps then do not run. Their results are kept, so every failure shows up in
one pass and the next attempt in the same run directory redoes only what is
missing. An iteration runs by asking for its provenance as the target:

  snakemake ... provenance/cohort/iteration-<n>.json

Dry-run it first: it must schedule only the three cohort steps. Commands are
recorded in provenance/run.json only when the run also uses GenoPilot's run
events logger (see the GenoPilot README).

The workflow trusts config.yaml, isolates.yaml, and the decisions as GenoPilot
saved them and does not check them again; do not edit them or the packaged
workflow.
"""

import shlex
import sys
from pathlib import Path

import yaml
from snakemake.exceptions import WorkflowError

configfile: "config.yaml"

# Packaged locations, relative to this Snakefile rather than the working directory. This
# workflow's own rules, scripts, and environments live next to it; shared/ holds only what
# annotation-transfer uses too.
WORKFLOW_DIR = Path(workflow.basedir)
RULES_DIR = WORKFLOW_DIR / "rules"
SCRIPTS_DIR = WORKFLOW_DIR / "scripts"
ENVS_DIR = WORKFLOW_DIR / "envs"
SCRIPTS_DIR_SH = shlex.quote(str(SCRIPTS_DIR))
SHARED_DIR = WORKFLOW_DIR.parent / "shared"
SHARED_ENVS_DIR = SHARED_DIR / "envs"
SHARED_SCRIPTS_DIR_SH = shlex.quote(str(SHARED_DIR / "scripts"))

sys.path.insert(0, str(SCRIPTS_DIR))
from artifacts import run_artifacts

# The selected isolates and their read files, from the run's isolates.yaml snapshot.
with open(config["inputs"]["isolates_file"], encoding="utf-8") as _snapshot:
    ISOLATES = yaml.safe_load(_snapshot)["isolates"]
ISOLATES_BY_ID = {isolate["id"]: isolate for isolate in ISOLATES}

# Every output a finished run must have, from the artifact list.
DECLARED_ARTIFACTS = [entry["path"] for entry in run_artifacts(ISOLATES) if entry["declared"]]

# Isolate IDs follow the catalog's ID format; read pairs are numbered from 1; a cohort is the
# initial one (iteration 1) or an iteration of a saved decision, numbered from 2.
wildcard_constraints:
    isolate="[a-z][a-z0-9]*(?:-[a-z0-9]+)*",
    pair="[1-9][0-9]*",
    cohort="initial|iteration-(?:[2-9]|[1-9][0-9]+)",


def read_pair_of(wildcards):
    """The snapshot entry of the read pair named by the `isolate` and `pair` wildcards."""
    return ISOLATES_BY_ID[wildcards.isolate]["read_pairs"][int(wildcards.pair) - 1]


def pair_numbers(isolate_id):
    """The 1-based numbers of an isolate's read pairs, in snapshot order."""
    return range(1, len(ISOLATES_BY_ID[isolate_id]["read_pairs"]) + 1)


def decision_path(cohort):
    """The saved decision of an iteration; the initial cohort has none."""
    return [] if cohort == "initial" else [f"decisions/{cohort}.yaml"]


def cohort_settings(cohort):
    """The voting isolates and consensus settings of a cohort: the configuration's for the initial
    one, the saved decision's for an iteration."""
    if cohort == "initial":
        return config["inputs"]["selected_isolates"], config["consensus"]
    path = Path(f"decisions/{cohort}.yaml")
    if not path.is_file():
        raise WorkflowError(f"{cohort} has no saved decision: {path} does not exist in the run directory")
    with path.open(encoding="utf-8") as decision_file:
        decision = yaml.safe_load(decision_file)
    return decision["voting_isolates"], decision["consensus"]


# The steps, in the order they run; see the list at the top of this file.
include: str(RULES_DIR / "resolve_backbone.smk")
include: str(RULES_DIR / "validate_run_inputs.smk")
include: str(RULES_DIR / "validate_read_pair.smk")
include: str(RULES_DIR / "align_reads.smk")
include: str(RULES_DIR / "call_variants.smk")
include: str(RULES_DIR / "build_consensus.smk")
include: str(RULES_DIR / "aggregate_support.smk")
include: str(RULES_DIR / "generate_consensus.smk")
include: str(RULES_DIR / "record_provenance.smk")


# The files a finished run must have. Asking for them makes Snakemake run every step above.
rule all:
    input:
        DECLARED_ARTIFACTS,
        "artifacts.yaml",
        "provenance/run.json",
