"""Reference-guided cohort consensus: one consensus genome from many isolates' reads.

Every selected isolate's paired reads are called against one backbone
assembly; the isolates' alleles (and optionally the backbone's) then vote at
each position, and the winner by strict majority or plurality forms the
cohort consensus.

Steps, in the order they run (each is one rule; paths are inside the run
directory, and every step writes its log to logs/):

  1. resolve_backbone                            rules/resolve_backbone.smk
       Copy a local FASTA or download an NCBI accession, with a checksum.
       -> resolved/backbone.fasta
  2. validate_run_inputs                         rules/validate_run_inputs.smk
       Check the backbone FASTA and that every read file can be read.
       -> results/input-validation.json

  Then, for every read pair of every selected isolate ({pair} is the pair's
  1-based position in the isolate's snapshot entry):

  3. validate_read_pair                          rules/validate_read_pair.smk
       Check both FASTQ files completely and derive the pair's read group.
       -> results/isolates/{isolate}/pairs/{pair}/read-validation.json, read-group.txt

  Not implemented yet (listed in manifest.yaml): the rest of per-isolate
  processing and calling, cohort support aggregation, and consensus
  generation.

The isolates and their read files come from isolates.yaml, a snapshot of the
isolate catalog that GenoPilot saved next to config.yaml when the run was
created, so later catalog edits never change an existing run.

Running without GenoPilot: GenoPilot saves config.yaml and isolates.yaml
into a new run directory. The same run can then be started directly with

  snakemake --snakefile <package>/workflows/reference-consensus/Snakefile \
    --directory <run-dir> --configfile <run-dir>/config.yaml \
    --cores <n> --use-conda

The workflow trusts config.yaml and isolates.yaml as GenoPilot saved them and
does not check them again; do not edit them or the packaged workflow.
"""

import shlex
from pathlib import Path

import yaml

configfile: "config.yaml"

# Packaged locations, relative to this Snakefile rather than the working directory. This
# workflow's own rules, scripts, and environments live next to it; shared/ holds only what
# annotation-transfer uses too.
WORKFLOW_DIR = Path(workflow.basedir)
RULES_DIR = WORKFLOW_DIR / "rules"
SCRIPTS_DIR = WORKFLOW_DIR / "scripts"
ENVS_DIR = WORKFLOW_DIR / "envs"
SCRIPTS_DIR_SH = shlex.quote(str(SCRIPTS_DIR))
SHARED_DIR = WORKFLOW_DIR.parent / "shared"
SHARED_ENVS_DIR = SHARED_DIR / "envs"
SHARED_SCRIPTS_DIR_SH = shlex.quote(str(SHARED_DIR / "scripts"))

# The selected isolates and their read files, from the run's isolates.yaml snapshot.
with open(config["inputs"]["isolates_file"], encoding="utf-8") as _snapshot:
    ISOLATES = yaml.safe_load(_snapshot)["isolates"]
ISOLATES_BY_ID = {isolate["id"]: isolate for isolate in ISOLATES}

# Isolate IDs follow the catalog's ID format; read pairs are numbered from 1.
wildcard_constraints:
    isolate="[a-z][a-z0-9]*(?:-[a-z0-9]+)*",
    pair="[1-9][0-9]*",


def read_pair_of(wildcards):
    """The snapshot entry of the read pair named by the `isolate` and `pair` wildcards."""
    return ISOLATES_BY_ID[wildcards.isolate]["read_pairs"][int(wildcards.pair) - 1]


def pair_numbers(isolate_id):
    """The 1-based numbers of an isolate's read pairs, in snapshot order."""
    return range(1, len(ISOLATES_BY_ID[isolate_id]["read_pairs"]) + 1)


def per_isolate(pattern):
    """Expands an `{isolate}` path pattern over every selected isolate."""
    return [pattern.format(isolate=isolate["id"]) for isolate in ISOLATES]


def per_pair(pattern):
    """Expands a `{isolate}`/`{pair}` path pattern over every read pair of the snapshot."""
    return [
        pattern.format(isolate=isolate["id"], pair=number)
        for isolate in ISOLATES
        for number in pair_numbers(isolate["id"])
    ]


# The steps, in the order they run; see the list at the top of this file.
include: str(RULES_DIR / "resolve_backbone.smk")
include: str(RULES_DIR / "validate_run_inputs.smk")
include: str(RULES_DIR / "validate_read_pair.smk")
include: str(RULES_DIR / "align_reads.smk")


# The files a finished run must have. Asking for them makes Snakemake run every step above.
rule all:
    input:
        "resolved/backbone.fasta",
        "results/input-validation.json",
        per_pair("results/isolates/{isolate}/pairs/{pair}/read-validation.json"),
        per_pair("results/isolates/{isolate}/pairs/{pair}/fastp.json"),
        per_isolate("results/isolates/{isolate}/alignment.bam"),
        per_isolate("results/isolates/{isolate}/markdup.json"),
        per_isolate("results/isolates/{isolate}/samtools-stats.txt"),
        per_isolate("results/isolates/{isolate}/flagstat.json"),
        per_isolate("results/isolates/{isolate}/coverage.tsv"),
